# Copiar como .env y reemplazar los valores. El ID debe ser el UUID del nodo en SafeCore.
SAFECORE_DEVICE_ID=00000000-0000-0000-0000-000000000001
EDGE_DEVICE_API_KEY=CAMBIA_ESTA_CLAVE_LARGA_Y_ALEATORIA
SAFECORE_DEVICE_SECRET=SECRETO_DEL_NODO_EN_EL_BACKEND
SAFECORE_API_BASE_URL=https://backend-safecore.onrender.com
EDGE_DB_PATH=data/safecore-edge.sqlite3
EDGE_HOST=0.0.0.0
EDGE_PORT=5000
SYNC_INTERVAL_SECONDS=5
